# Service key for the GeneBe API (optional; gives higher rate limits). Never expose to clients.
GENEBE_API_KEY=
GENEBE_API_URL=https://api.genebe.net/cloud/api-public
GENEBE_PORT=17843
# Proxies whose X-Forwarded-For is trusted for the end user IP (comma separated)
GENEBE_TRUSTED_PROXIES=127.0.0.1,::1
